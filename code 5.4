#include <stdio.h>

float area(float base, float height)
{
    return 0.5 * base * height;
}

int main()
{
    float base, height, result;

    printf("Enter base of triangle: ");
    scanf("%f", &base);

    printf("Enter height of triangle: ");
    scanf("%f", &height);

    result = area(base, height);

    printf("Area of triangle = %.2f\n", result);

    return 0;
}
