#include <stdio.h>

void area(float base, float height)
{
    float result;

    result = 0.5 * base * height;

    printf("Area of triangle = %.2f\n", result);
}

int main()
{
    float base, height;

    printf("Enter base of triangle: ");
    scanf("%f", &base);

    printf("Enter height of triangle: ");
    scanf("%f", &height);

    area(base, height);

    return 0;
}
